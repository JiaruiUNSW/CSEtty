* text=auto

# These files are copied into Linux Docker build contexts. A Windows checkout
# must not rewrite their interpreters or shell syntax to CRLF.
*.sh text eol=lf
docker/Dockerfile.* text eol=lf
docker/dcc-command text eol=lf
docker/exam-command text eol=lf
docker/mipsy-command text eol=lf

# Test fixtures are byte-exact inputs. Git must not add CR bytes when a Windows
# checkout enables core.autocrlf, including for printable .bin fixtures.
question_bank/**/tests/** -text
packs/**/tests/** -text
