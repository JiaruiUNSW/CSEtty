{
  "schema_version": 1,
  "id": "c1511-adv-037",
  "title": "Resizable integer console",
  "kind": "c_program",
  "difficulty": 5,
  "track": "challenge",
  "tags": [
    "whole-program",
    "dynamic-memory",
    "arrays-1d",
    "pointers",
    "io"
  ],
  "weeks": [
    7,
    9
  ],
  "slots": [
    "whole_program"
  ],
  "estimated_minutes": 48,
  "points": 10,
  "pass_points": 5,
  "prompt": "prompt.md",
  "solution": "solution.md",
  "starter_files": [
    "starter/c1511_adv_037.c"
  ],
  "submission_files": [
    "c1511_adv_037.c"
  ],
  "build": {
    "argv": [
      "dcc",
      "-Werror",
      "c1511_adv_037.c",
      "-o",
      "c1511_adv_037"
    ]
  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 5,
      "tests": [
        {
          "id": "basic",
          "argv": [
            "./c1511_adv_037"
          ],
          "stdin": "PUSH 1\nPUSH 2\nPUSH 3\nROLL 1\nPRINT\nEND\n",
          "expected_stdout": "3 1 2\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "edge",
          "argv": [
            "./c1511_adv_037"
          ],
          "stdin": "DROP\nPRINT\nEND\n",
          "expected_stdout": "EMPTY\nEMPTY\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 5,
      "tests": [
        {
          "id": "hidden_state",
          "argv": [
            "./c1511_adv_037"
          ],
          "stdin": "PUSH 2\nPUSH 1\nPUSH 2\nPUSH 3\nUNIQUE\nPRINT\nEND\n",
          "expected_stdout": "2 1 3\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "hidden_mixed",
          "argv": [
            "./c1511_adv_037"
          ],
          "stdin": "PUSH -1\nPUSH 4\nROLL 5\nPRINT\nDROP\nPRINT\nEND\n",
          "expected_stdout": "4 -1\nDROPPED -1\n4\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1511_adv_037"
          ],
          "stdin": "PUSH -1\nPUSH 4\nROLL 6\nPRINT\nDROP\nPRINT\nEND\n",
          "expected_stdout": "-1 4\nDROPPED 4\n-1\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "comparison": "exact"
        }
      ]
    }
  ]
}
