  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 5,
      "tests": [
        {
          "id": "sum-wins",
          "argv": [
            "./c1511_core_031"
          ],
          "stdin": "3 3\n1 2 3\n4 0 2\n-1 10 -1\n",
          "expected_stdout": "row: 2\nsum: 8\nrange: 11\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "range-tie",
          "argv": [
            "./c1511_core_031"
          ],
          "stdin": "2 2\n1 3\n2 2\n",
          "expected_stdout": "row: 1\nsum: 4\nrange: 0\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "one-row",
          "argv": [
            "./c1511_core_031"
          ],
          "stdin": "1 4\n5 1 5 1\n",
          "expected_stdout": "row: 0\nsum: 12\nrange: 4\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "negative",
          "argv": [
            "./c1511_core_031"
          ],
          "stdin": "3 2\n-5 -1\n-2 -2\n-3 0\n",
          "expected_stdout": "row: 2\nsum: -3\nrange: 3\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1511_core_031"
          ],
          "stdin": "3 2\n-5 -1\n-2 -2\n-3 1\n",
          "expected_stdout": "row: 2\nsum: -2\nrange: 4\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "comparison": "exact"
        }
      ]
    }
  ]
}
