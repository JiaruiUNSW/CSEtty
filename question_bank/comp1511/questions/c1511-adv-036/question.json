    ]
  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 5,
      "tests": [
        {
          "id": "basic",
          "argv": [
            "./c1511_adv_036"
          ],
          "stdin": "APPEND red\nAPPEND blue\nPREPEND green\nPRINT\nEND\n",
          "expected_stdout": "green -> red -> blue\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "edge",
          "argv": [
            "./c1511_adv_036"
          ],
          "stdin": "PRINT\nEND\n",
          "expected_stdout": "EMPTY\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 5,
      "tests": [
        {
          "id": "hidden_state",
          "argv": [
            "./c1511_adv_036"
          ],
          "stdin": "APPEND a\nAPPEND b\nAPPEND c\nREVERSE\nREMOVE b\nPRINT\nEND\n",
          "expected_stdout": "REMOVED b\nc -> a\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "hidden_mixed",
          "argv": [
            "./c1511_adv_036"
          ],
          "stdin": "APPEND x\nAPPEND x\nREMOVE x\nPRINT\nREMOVE z\nEND\n",
          "expected_stdout": "REMOVED x\nx\nMISSING z\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1511_adv_036"
          ],
          "stdin": "APPEND x\nAPPEND x\nREMOVE x\nPRINT\nREMOVE z\nENE\n",
          "expected_stdout": "REMOVED x\nx\nMISSING z\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "comparison": "exact"
        }
      ]
    }
  ]
}
