          ],
          "stdin": "10 30 45\n",
          "expected_stdout": "11:15\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "midnight",
          "argv": [
            "./c1511_core_026"
          ],
          "stdin": "23 50 20\n",
          "expected_stdout": "00:10\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 3,
      "tests": [
        {
          "id": "negative",
          "argv": [
            "./c1511_core_026"
          ],
          "stdin": "0 5 -10\n",
          "expected_stdout": "23:55\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "half-day",
          "argv": [
