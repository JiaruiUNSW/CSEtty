      "tests": [
        {
          "id": "banana",
          "argv": [
            "./c1511_core_033"
          ],
          "stdin": "banana\n",
          "expected_stdout": "a: 3\nb: 1\nn: 2\ndistinct: 3\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "alphabet-start",
          "argv": [
            "./c1511_core_033"
          ],
          "stdin": "abc\n",
          "expected_stdout": "a: 1\nb: 1\nc: 1\ndistinct: 3\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "one-letter",
          "argv": [
            "./c1511_core_033"
          ],
          "stdin": "zzzz\n",
          "expected_stdout": "z: 4\ndistinct: 1\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "mississippi",
          "argv": [
            "./c1511_core_033"
          ],
          "stdin": "mississippi\n",
          "expected_stdout": "i: 4\nm: 1\np: 2\ns: 4\ndistinct: 4\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1511_core_033"
          ],
          "stdin": "mississippj\n",
          "expected_stdout": "i: 3\nj: 1\nm: 1\np: 2\ns: 4\ndistinct: 5\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "comparison": "exact"
        }
      ]
    }
  ]
