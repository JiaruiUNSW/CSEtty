  "tags": [
    "arrays-2d",
    "loops",
    "functions"
  ],
  "weeks": [
    5
  ],
  "slots": [
    "array_hurdle"
  ],
  "estimated_minutes": 16,
  "points": 12,
  "pass_points": 6,
  "prompt": "prompt.md",
  "solution": "solution.md",
  "starter_files": [
    "starter/c1511_core_010.c"
  ],
  "submission_files": [
    "c1511_core_010.c"
  ],
  "build": {
    "argv": [
      "dcc",
      "-Werror",
      "c1511_core_010.c",
      "-o",
      "c1511_core_010"
    ]
  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 6,
      "tests": [
        {
          "id": "two-changes",
          "argv": [
            "./c1511_core_010"
          ],
          "stdin": "4\n1 9 9 9\n8 1 8 8\n7 7 2 7\n6 6 6 3\n",
          "expected_stdout": "diagonal changes: 2\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "single",
          "argv": [
            "./c1511_core_010"
          ],
          "stdin": "1\n42\n",
          "expected_stdout": "diagonal changes: 0\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "constant",
          "argv": [
            "./c1511_core_010"
          ],
          "stdin": "3\n5 0 0\n0 5 0\n0 0 5\n",
          "expected_stdout": "diagonal changes: 0\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "alternating",
          "argv": [
            "./c1511_core_010"
          ],
          "stdin": "5\n0 8 8 8 8\n8 1 8 8 8\n8 8 0 8 8\n8 8 8 1 8\n8 8 8 8 0\n",
          "expected_stdout": "diagonal changes: 4\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1511_core_010"
          ],
          "stdin": "5\n0 8 8 8 8\n8 1 8 8 8\n8 8 0 8 8\n8 8 8 1 8\n8 8 8 8 1\n",
          "expected_stdout": "diagonal changes: 3\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "comparison": "exact"
        }
      ]
    }
  ]
}
