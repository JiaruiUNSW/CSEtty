          "argv": [
            "./c1511_core_024"
          ],
          "stdin": "  hello   world \n",
          "expected_stdout": "hello world\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "tabs",
          "argv": [
            "./c1511_core_024"
          ],
          "stdin": "a\t\tb c\n",
          "expected_stdout": "a b c\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 3,
      "tests": [
        {
          "id": "blank",
          "argv": [
            "./c1511_core_024"
          ],
          "stdin": " \t  \n",
          "expected_stdout": "\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "punctuation",
          "argv": [
            "./c1511_core_024"
          ],
          "stdin": " x,   y! \n",
          "expected_stdout": "x, y!\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    }
  ]
