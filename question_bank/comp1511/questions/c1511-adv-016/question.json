          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "hidden_boundary",
          "argv": [
            "./c1511_adv_016",
