            "--"
          ],
          "expected_stdout": "EMPTY\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1511_adv_016",
            "-2",
            "0",
            "0",
            "7",
            "--",
            "-2",
            "3",
            "8"
          ],
          "expected_stdout": "-2 0 3 7 8\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "comparison": "exact"
        }
      ]
    }
