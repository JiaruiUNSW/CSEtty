  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 4,
      "tests": [
        {
          "id": "descending",
          "argv": [
            "mipsy",
            "c1521_low_002.s"
          ],
          "stdin": "9\n2\n",
          "expected_stdout": "7\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "ascending",
          "argv": [
            "mipsy",
            "c1521_low_002.s"
          ],
          "stdin": "2\n9\n",
          "expected_stdout": "7\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "equal",
          "argv": [
            "mipsy",
            "c1521_low_002.s"
          ],
          "stdin": "-4\n-4\n",
          "expected_stdout": "0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "mixed_signs",
          "argv": [
            "mipsy",
            "c1521_low_002.s"
          ],
          "stdin": "-10\n6\n",
          "expected_stdout": "16\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    }
  ]
