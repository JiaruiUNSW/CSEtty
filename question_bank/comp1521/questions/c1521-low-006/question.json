{
  "schema_version": 1,
  "id": "c1521-low-006",
  "title": "Count Even Samples",
  "kind": "mips_program",
  "difficulty": 2,
  "track": "normal",
  "tags": [
    "mips-control",
    "bitwise"
  ],
  "weeks": [
    2,
    4
  ],
  "slots": [
    "foundation"
  ],
  "estimated_minutes": 14,
  "points": 10,
  "pass_points": 4,
  "prompt": "prompt.md",
  "solution": "solution.md",
  "starter_files": [
    "starter/c1521_low_006.s"
  ],
  "submission_files": [
    "c1521_low_006.s"
  ],
  "build": {
    "argv": []
  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 4,
      "tests": [
        {
          "id": "mixed",
          "argv": [
            "mipsy",
            "c1521_low_006.s"
          ],
          "stdin": "1\n2\n3\n4\n6\n",
          "expected_stdout": "3\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "all_odd",
          "argv": [
            "mipsy",
            "c1521_low_006.s"
          ],
          "stdin": "1\n-3\n5\n7\n9\n",
          "expected_stdout": "0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "zeros",
          "argv": [
            "mipsy",
            "c1521_low_006.s"
          ],
          "stdin": "0\n0\n0\n0\n0\n",
          "expected_stdout": "5\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "negative_even",
          "argv": [
            "mipsy",
            "c1521_low_006.s"
          ],
          "stdin": "-2\n-4\n3\n8\n11\n",
          "expected_stdout": "3\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    }
  ]
}
