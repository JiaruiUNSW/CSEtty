  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 4,
      "tests": [
        {
          "id": "patterns",
          "argv": [
            "./c1521_bits_017"
          ],
          "stdin": "12345678 00ff00ff 8\n",
          "expected_stdout": "result: 123456ff\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "zero",
          "argv": [
            "./c1521_bits_017"
          ],
          "stdin": "00000000 00000000 0\n",
          "expected_stdout": "result: 00000000\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "high-bit",
          "argv": [
            "./c1521_bits_017"
          ],
          "stdin": "80000001 0f0f0f0f 31\n",
          "expected_stdout": "result: 8f0f0f0f\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "all-bits",
          "argv": [
            "./c1521_bits_017"
          ],
          "stdin": "ffffffff aaaaaaaa 16\n",
          "expected_stdout": "result: ffffaaaa\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "boundary",
          "argv": [
            "./c1521_bits_017"
          ],
          "stdin": "000000ff 0000ff00 4\n",
          "expected_stdout": "result: 000000f0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    }
  ]
