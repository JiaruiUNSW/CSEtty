    "c1521_bits_017.c"
  ],
  "build": {
    "argv": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-Werror",
      "c1521_bits_017.c",
      "-o",
      "c1521_bits_017"
