{
  "schema_version": 1,
  "id": "c1521-fs-015",
  "title": "Recursive suffix summary",
  "kind": "c_program",
  "difficulty": 4,
  "track": "challenge",
  "tags": [
    "directories",
    "recursive-traversal",
    "file-metadata"
  ],
  "weeks": [
    8,
    9
  ],
  "slots": [
    "advanced_systems"
  ],
  "estimated_minutes": 42,
  "points": 10,
  "pass_points": 4,
  "prompt": "prompt.md",
  "solution": "solution.md",
  "starter_files": [
    "starter/c1521_fs_015.c"
  ],
  "submission_files": [
    "c1521_fs_015.c"
  ],
  "build": {
    "argv": [
      "dcc",
      "-Werror",
      "c1521_fs_015.c",
      "-o",
      "c1521_fs_015"
    ]
  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 4,
      "tests": [
        {
          "id": "nested-text",
          "argv": [
            "./c1521_fs_015",
            "tree",
            ".txt"
          ],
          "expected_stdout": "files=2 bytes=7\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/aa.txt",
              "path": "tree/a.txt"
            },
            {
              "source": "tests/bbb.txt",
              "path": "tree/sub/b.txt"
            },
            {
              "source": "tests/x.bin",
              "path": "tree/sub/x.bin"
            }
          ]
        },
        {
          "id": "no-match",
          "argv": [
            "./c1521_fs_015",
            "tree",
            ".c"
          ],
          "expected_stdout": "files=0 bytes=0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/x.bin",
              "path": "tree/x.bin"
            }
          ]
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "deep-match",
          "argv": [
            "./c1521_fs_015",
            "tree",
            ".log"
          ],
          "expected_stdout": "files=3 bytes=9\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/aa.txt",
              "path": "tree/a.log"
            },
            {
              "source": "tests/aa.txt",
              "path": "tree/one/b.log"
            },
            {
              "source": "tests/aa.txt",
              "path": "tree/one/two/c.log"
            }
          ]
        },
        {
          "id": "whole-name-suffix",
          "argv": [
            "./c1521_fs_015",
            "tree",
            "note"
          ],
          "expected_stdout": "files=2 bytes=5\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/aa.txt",
              "path": "tree/note"
            },
            {
              "source": "tests/x.bin",
              "path": "tree/sub/mynote"
            }
          ]
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1521_fs_015",
            "tree",
            "notf"
          ],
          "expected_stdout": "files=0 bytes=0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/aa.txt",
              "path": "tree/note"
            },
            {
              "source": "tests/x.bin",
              "path": "tree/sub/mynote"
            }
          ],
          "comparison": "exact"
        }
      ]
    }
  ]
}
