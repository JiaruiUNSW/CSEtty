      "tests": [
        {
          "id": "add",
          "argv": [
            "./c1521_low_030"
          ],
          "stdin": "012a4020\n",
          "expected_stdout": "9 10 8 0 32\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "zero",
          "argv": [
            "./c1521_low_030"
          ],
          "stdin": "00000000\n",
          "expected_stdout": "0 0 0 0 0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "shift",
          "argv": [
            "./c1521_low_030"
          ],
          "stdin": "00094100\n",
          "expected_stdout": "0 9 8 4 0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "all_fields",
          "argv": [
            "./c1521_low_030"
          ],
          "stdin": "03ffffff\n",
          "expected_stdout": "31 31 31 31 63\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1521_low_030"
          ],
          "stdin": "03fffffg\n",
          "expected_stdout": "1 31 31 31 63\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000,
          "comparison": "exact"
        }
      ]
    }
  ]
