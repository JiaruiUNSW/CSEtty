          "argv": [
            "./c1521_fs_023",
            "source",
            "out",
            "2",
            "4"
          ],
          "expected_stdout": "4\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/alphabet.txt",
              "path": "source"
            }
          ],
          "expected_files": [
            {
              "path": "out",
              "content": "cdef"
            }
          ]
        },
        {
          "id": "zero-length",
          "argv": [
            "./c1521_fs_023",
            "source",
            "out",
            "3",
            "0"
          ],
          "expected_stdout": "0\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/alphabet.txt",
              "path": "source"
            }
          ],
          "expected_files": [
            {
              "path": "out",
              "content": ""
            }
          ]
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "past-eof",
          "argv": [
            "./c1521_fs_023",
            "source",
            "out",
            "8",
            "10"
          ],
          "expected_stdout": "3\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/alphabet.txt",
              "path": "source"
            }
          ],
          "expected_files": [
            {
              "path": "out",
              "content": "ij\n"
            }
          ]
        },
        {
          "id": "whole-file",
          "argv": [
            "./c1521_fs_023",
            "source",
            "out",
            "0",
            "20"
          ],
          "expected_stdout": "5\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/tiny.txt",
              "path": "source"
            }
          ],
          "expected_files": [
