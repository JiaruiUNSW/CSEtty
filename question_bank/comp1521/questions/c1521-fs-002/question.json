{
  "schema_version": 1,
  "id": "c1521-fs-002",
  "title": "Round-trip big-endian words",
  "kind": "c_program",
  "difficulty": 2,
  "track": "normal",
  "tags": [
    "file-io",
    "binary-data",
    "integer-representation"
  ],
  "weeks": [
    4,
    7
  ],
  "slots": [
    "foundation"
  ],
  "estimated_minutes": 22,
  "points": 10,
  "pass_points": 4,
  "prompt": "prompt.md",
  "solution": "solution.md",
  "starter_files": [
    "starter/c1521_fs_002.c"
  ],
  "submission_files": [
    "c1521_fs_002.c"
  ],
  "build": {
    "argv": [
      "dcc",
      "-Werror",
      "c1521_fs_002.c",
      "-o",
      "c1521_fs_002"
    ]
  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 4,
      "tests": [
        {
          "id": "three-words",
          "argv": [
            "./c1521_fs_002",
            "words.bin"
          ],
          "stdin": "1\n256\n65537\n",
          "expected_stdout": "count=3 checksum=65794\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "empty-input",
          "argv": [
            "./c1521_fs_002",
            "words.bin"
          ],
          "stdin": "",
          "expected_stdout": "count=0 checksum=0\n",
          "expected_stderr": "",
          "expected_exit": 0
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "boundary-words",
          "argv": [
            "./c1521_fs_002",
            "words.bin"
          ],
          "stdin": "0\n4294967295\n",
          "expected_stdout": "count=2 checksum=4294967295\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "wrapping-checksum",
          "argv": [
            "./c1521_fs_002",
            "words.bin"
          ],
          "stdin": "4294967295\n2\n8\n",
          "expected_stdout": "count=3 checksum=9\n",
          "expected_stderr": "",
          "expected_exit": 0
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1521_fs_002",
            "words.bin"
          ],
          "stdin": "4294967295\n2\n9\n",
          "expected_stdout": "count=3 checksum=10\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "comparison": "exact"
        }
      ]
    }
  ]
}
