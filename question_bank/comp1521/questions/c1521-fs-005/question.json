          "expected_stdout": "32 33 34 35\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/digits.txt",
              "path": "data"
            }
          ]
        },
        {
          "id": "zero-length",
          "argv": [
            "./c1521_fs_005",
            "data",
            "3",
            "0"
          ],
          "expected_stdout": "\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/digits.txt",
              "path": "data"
            }
          ]
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "past-eof",
          "argv": [
            "./c1521_fs_005",
            "data",
            "8",
            "8"
          ],
          "expected_stdout": "38 39 0a\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/digits.txt",
              "path": "data"
            }
          ]
        },
        {
          "id": "whole-word",
          "argv": [
            "./c1521_fs_005",
            "data",
            "0",
            "5"
          ],
          "expected_stdout": "48 65 6c 6c 6f\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/hello.txt",
              "path": "data"
            }
          ]
        },
        {
          "id": "extended-edge",
          "argv": [
            "./c1521_fs_005",
            "data",
            "0",
            "6"
          ],
          "expected_stdout": "48 65 6c 6c 6f 0a\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "fixtures": [
            {
              "source": "tests/hello.txt",
              "path": "data"
