  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 4,
      "tests": [
        {
          "id": "overlap",
          "argv": [
            "./c1521_low_018"
          ],
          "stdin": "0000000a 00000005 00000008\n",
          "expected_stdout": "00000007\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "unchanged",
          "argv": [
            "./c1521_low_018"
          ],
          "stdin": "deadbeef 00000000 00000000\n",
          "expected_stdout": "deadbeef\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    },
    {
      "id": "marking",
      "visibility": "after_finish",
      "points": 6,
      "tests": [
        {
          "id": "clear_all",
          "argv": [
            "./c1521_low_018"
          ],
          "stdin": "12345678 00000000 ffffffff\n",
          "expected_stdout": "00000000\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "set_then_clear",
          "argv": [
            "./c1521_low_018"
          ],
          "stdin": "00000000 ffffffff 00ff00ff\n",
          "expected_stdout": "ff00ff00\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    }
  ]
}
