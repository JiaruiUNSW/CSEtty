  "starter_files": [
    "starter/c1521_low_018.c"
  ],
  "submission_files": [
    "c1521_low_018.c"
  ],
  "build": {
    "argv": [
      "dcc",
      "-Werror",
      "c1521_low_018.c",
      "-o",
