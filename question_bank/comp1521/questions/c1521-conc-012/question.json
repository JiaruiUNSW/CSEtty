  ],
  "slots": [
    "processes_threads"
  ],
  "estimated_minutes": 35,
  "points": 10,
  "pass_points": 5,
  "prompt": "prompt.md",
  "solution": "solution.md",
  "starter_files": [
    "starter/c1521_conc_012.c"
  ],
  "submission_files": [
    "c1521_conc_012.c"
  ],
  "build": {
    "argv": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-Werror",
      "c1521_conc_012.c",
      "-pthread",
      "-o",
      "c1521_conc_012"
    ]
  },
  "test_groups": [
    {
      "id": "public",
      "visibility": "public",
      "points": 5,
      "tests": [
        {
          "id": "overlap",
          "argv": [
            "./c1521_conc_012",
            "abc",
            "Baa"
          ],
          "expected_stdout": "a=3\nb=2\nc=1\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "one-letter",
          "argv": [
            "./c1521_conc_012",
            "zzz"
          ],
          "expected_stdout": "z=3\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    },
    {
      "id": "after-finish",
      "visibility": "after_finish",
      "points": 5,
      "tests": [
        {
          "id": "mixed-case",
          "argv": [
            "./c1521_conc_012",
            "Hello",
            "WORLD"
          ],
          "expected_stdout": "d=1\ne=1\nh=1\nl=3\no=2\nr=1\nw=1\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        },
        {
          "id": "empty-and-punctuation",
          "argv": [
            "./c1521_conc_012",
            "---",
            "a-A!"
          ],
          "expected_stdout": "a=2\n",
          "expected_stderr": "",
          "expected_exit": 0,
          "timeout_ms": 3000
        }
      ]
    }
  ]
}
